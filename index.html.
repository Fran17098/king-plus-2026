<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#090a0f">
<title>KING PLUS 2026</title>
<style>
:root{--bg:#090a0f;--panel:#12141c;--gold:#e4bd61;--text:#f6f4ef;--muted:#a7a9b5;--line:#292b35}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:16px system-ui,-apple-system,Segoe UI,sans-serif}button,input{font:inherit}button{cursor:pointer;border:0;border-radius:10px;padding:12px 16px;font-weight:700}.gold{background:var(--gold);color:#17130a}.ghost{background:#242630;color:white;border:1px solid #393b46}.wrap{max-width:1100px;margin:auto;padding:20px}.top{display:flex;align-items:center;justify-content:space-between;gap:12px;border-bottom:1px solid var(--line);padding-bottom:16px}.brand{display:flex;align-items:center;gap:10px;font-weight:900;letter-spacing:1px;color:var(--gold);font-size:1.3rem}.crown{display:grid;place-items:center;background:var(--gold);color:#111;width:40px;height:40px;border-radius:12px;font-size:22px}.nav{display:flex;gap:8px;flex-wrap:wrap}.hero{margin:22px 0;padding:clamp(24px,5vw,48px);border-radius:20px;min-height:240px;background:radial-gradient(ellipse at 80% 30%,#594622 0,transparent 35%),linear-gradient(120deg,#20232d,#0c0d12 70%);border:1px solid #383023;display:flex;flex-direction:column;justify-content:center;align-items:flex-start}.eyebrow{color:var(--gold);font-weight:800;letter-spacing:2px;font-size:.8rem}.hero h1{font-size:clamp(2rem,7vw,4rem);line-height:1.02;margin:12px 0;max-width:650px}.hero p{color:#c4c5ce;max-width:520px;line-height:1.5}.tools{display:flex;gap:10px;flex-wrap:wrap;margin:20px 0}.tools input{flex:1;min-width:180px;background:var(--panel);border:1px solid var(--line);color:white;padding:12px;border-radius:10px}.section-head{display:flex;justify-content:space-between;align-items:center;gap:10px}.section-head h2{font-size:1.25rem}.muted{color:var(--muted);font-size:.9rem}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(145px,1fr));gap:14px}.movie{background:var(--panel);border:1px solid var(--line);border-radius:14px;overflow:hidden}.poster{height:180px;display:flex;align-items:flex-end;padding:12px;background:linear-gradient(155deg,var(--c1),#101119 78%);position:relative}.poster:before{content:'▶';position:absolute;top:14px;right:14px;border:1px solid #ffffff60;border-radius:50%;width:34px;height:34px;display:grid;place-items:center;background:#0004}.poster span{font-size:1.05rem;font-weight:900;text-shadow:0 2px 8px #000}.moviebody{padding:12px}.moviebody h3{font-size:.95rem;margin:0 0 5px}.moviebody p{font-size:.8rem;color:var(--muted);margin:0 0 10px}.moviebody button{width:100%;padding:9px;font-size:.85rem}.hide{display:none!important}.login{max-width:420px;margin:10vh auto;padding:26px;border:1px solid var(--line);border-radius:18px;background:var(--panel)}.login h1{color:var(--gold);margin-bottom:4px}.login input{display:block;width:100%;margin:12px 0;padding:13px;background:#090a0f;color:white;border:1px solid #393b46;border-radius:10px}.login button{width:100%}.notice{font-size:.82rem;line-height:1.5;color:var(--muted);margin-top:16px}.player{position:fixed;inset:0;background:#000e;display:grid;place-items:center;padding:20px;z-index:5}.playerbox{max-width:620px;width:100%;padding:24px;background:#15161d;border:1px solid #49402a;border-radius:18px}.screen{aspect-ratio:16/9;background:linear-gradient(145deg,#222530,#050608);display:grid;place-items:center;border-radius:12px;margin:14px 0;color:var(--gold);font-size:2.5rem}.foot{margin:36px 0 10px;border-top:1px solid var(--line);padding-top:18px;color:var(--muted);font-size:.82rem}
</style></head>
<body>
<div id="login" class="wrap">
 <div class="login"><div class="brand"><div class="crown">♛</div>KING PLUS</div><p class="muted">Tu entretenimiento, en un solo lugar.</p><h1>Bienvenido</h1><p class="muted">Acceso de demostración</p><form id="loginForm"><input id="username" autocomplete="username" placeholder="Usuario de prueba" required><input id="password" type="password" autocomplete="current-password" placeholder="Contraseña de prueba" required><button class="gold" type="submit">Entrar a KING PLUS</button></form><p class="notice">Prototipo: este formulario solo simula el inicio de sesión en este dispositivo. No uses contraseñas reales. Para cuentas seguras necesitas un backend con autenticación.</p><button id="demo" class="ghost" style="width:100%;margin-top:8px">Entrar en modo demostración</button></div>
</div>
<main id="app" class="wrap hide">
 <header class="top"><div class="brand"><div class="crown">♛</div><span>KING PLUS <small style="font-size:.65rem;color:#fff">2026</small></span></div><div class="nav"><button class="ghost" id="allBtn">Inicio</button><button class="ghost" id="favBtn">♥ Favoritos</button><button class="ghost" id="logout">Salir</button></div></header>
 <section class="hero"><div class="eyebrow">STREAMING · TU CATÁLOGO</div><h1>Grandes historias.<br>Una sola corona.</h1><p>Descubre películas y series. Conecta tu propio servidor de streaming cuando tengas lista la dirección autorizada del reproductor.</p><button class="gold" id="browse">▶ Explorar catálogo</button></section>
 <div class="tools"><input id="search" placeholder="Buscar películas o series…" aria-label="Buscar catálogo"><button class="ghost" id="clearSearch">Limpiar</button></div>
 <div class="section-head"><h2 id="listTitle">Películas y series populares</h2><span class="muted">Contenido de muestra</span></div><div class="grid" id="grid"></div>
 <footer class="foot">KING PLUS 2026 · Prototipo independiente. Solo agrega contenido que poseas o tengas autorización para distribuir.</footer>
</main>
<div id="player" class="player hide" role="dialog" aria-modal="true"><div class="playerbox"><div class="section-head"><h2 id="playerTitle">Reproductor</h2><button class="ghost" id="closePlayer">Cerrar ✕</button></div><div class="screen">▶</div><p id="playerText" class="muted">Reproductor de demostración. Aún no hay una fuente de video configurada.</p><label class="muted" for="streamUrl">URL de video autorizada (opcional)</label><input id="streamUrl" placeholder="https://tu-servidor/video.m3u8" style="width:100%;padding:12px;margin:8px 0;background:#090a0f;color:white;border:1px solid #393b46;border-radius:10px"><button class="gold" id="loadStream">Abrir fuente</button><video id="video" controls playsinline class="hide" style="width:100%;margin-top:12px"></video><p class="notice">No pegues aquí credenciales privadas. Para reproducir formatos como HLS (.m3u8) puede ser necesario un reproductor compatible y configurar CORS en tu servidor.</p></div></div>
<script>
const titles=[['Horizonte de Acero','Acción · 2026','#31516b'],['La Última Órbita','Ciencia ficción · 2026','#50365e'],['Código Fantasma','Suspenso · 2025','#3b4851'],['Reino de Ceniza','Aventura · 2026','#72503a'],['Luces de Medianoche','Drama · 2025','#3b3d69'],['Planeta Azul','Documental · 2026','#28675c'],['Operación Norte','Acción · 2025','#71503d'],['El Archivo Secreto','Misterio · 2026','#5b3c43']];let favorites=new Set();let showingFav=false;
const grid=document.getElementById('grid');function render(){const q=document.getElementById('search').value.toLowerCase();const list=titles.filter((m,i)=>m[0].toLowerCase().includes(q)&&(!showingFav||favorites.has(i)));document.getElementById('listTitle').textContent=showingFav?'Mis favoritos':'Películas y series populares';grid.innerHTML='';list.forEach(m=>{const i=titles.indexOf(m),card=document.createElement('article');card.className='movie';card.innerHTML=`<div class="poster" style="--c1:${m[2]}"><span>${m[0]}</span></div><div class="moviebody"><h3>${m[0]}</h3><p>${m[1]}</p><button class="gold play">▶ Ver ficha</button><button class="ghost favorite" style="margin-top:7px">${favorites.has(i)?'♥ Guardado':'♡ Favorito'}</button></div>`;card.querySelector('.play').onclick=()=>openPlayer(m[0]);card.querySelector('.favorite').onclick=()=>{favorites.has(i)?favorites.delete(i):favorites.add(i);render()};grid.appendChild(card)});if(!list.length)grid.innerHTML='<p class="muted">No se encontraron títulos.</p>'}
function enter(){document.getElementById('login').classList.add('hide');document.getElementById('app').classList.remove('hide');render()}document.getElementById('loginForm').addEventListener('submit',e=>{e.preventDefault();alert('Este acceso es solo de demostración; no valida cuentas reales.');enter()});document.getElementById('demo').onclick=enter;document.getElementById('logout').onclick=()=>{document.getElementById('app').classList.add('hide');document.getElementById('login').classList.remove('hide')};document.getElementById('search').oninput=render;document.getElementById('clearSearch').onclick=()=>{document.getElementById('search').value='';render()};document.getElementById('favBtn').onclick=()=>{showingFav=true;render()};document.getElementById('allBtn').onclick=()=>{showingFav=false;document.getElementById('search').value='';render()};document.getElementById('browse').onclick=()=>document.getElementById('search').focus();function openPlayer(name){document.getElementById('playerTitle').textContent=name;document.getElementById('player').classList.remove('hide');document.getElementById('video').classList.add('hide')}document.getElementById('closePlayer').onclick=()=>{document.getElementById('player').classList.add('hide');const v=document.getElementById('video');v.pause();v.removeAttribute('src');v.load()};document.getElementById('loadStream').onclick=()=>{const url=document.getElementById('streamUrl').value.trim();if(!url){alert('Ingresa una URL de video autorizada.');return}if(!/^https:\/\//i.test(url)){alert('Por seguridad, usa una dirección HTTPS.');return}const v=document.getElementById('video');v.src=url;v.classList.remove('hide');v.play().catch(()=>alert('La fuente no pudo reproducirse. Verifica el formato y la configuración del servidor.'))};
</script></body></html>
